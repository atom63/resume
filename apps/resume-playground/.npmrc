# This app consumes the PUBLISHED @atom63/resume from the public npm registry.
# The monorepo root .npmrc scopes @atom63 to GitHub Packages for PUBLISHING;
# override it here so a standalone install (see installCommand: --ignore-workspace)
# resolves the dependency from npmjs.org in both the monorepo and the mirror.
@atom63:registry=https://registry.npmjs.org/
