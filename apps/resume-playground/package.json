{
  "name": "resume-playground",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Standalone, deployable live playground for @atom63/resume — edit MDX in the browser (by hand or with an LLM) and export a print-ready PDF. Consumes the PUBLISHED package; excluded from the monorepo workspace and deployed from the public mirror.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.app.json"
  },
  "dependencies": {
    "@atom63/resume": "^0.2.3",
    "@mdx-js/react": "^3.1.1",
    "lucide-react": "^1.18.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@mdx-js/rollup": "^3.1.1",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^4.7.0",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-mdx-frontmatter": "^5.2.0",
    "typescript": "~5.8.3",
    "vite": "^7.1.5"
  }
}
